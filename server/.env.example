# ---- Server ----
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ---- Database ----
DATABASE_URL=postgresql://postgres:YOURPASSWORD@localhost:5432/freehall

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# ---- Mail (Gmail SMTP for OTP resets) ----
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---- Feature defaults (informational; real flags live in DB) ----
DEFAULT_UNIVERSITY_CODE=UBa